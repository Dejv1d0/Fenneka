<?xml version="1.0" encoding="UTF-8" ?>
<Shell
    x:Class="Fenneka.Mobile.AppShell"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:local="clr-namespace:Fenneka.Mobile"
    Title="Fenneka.Mobile"
    FlyoutBehavior="Disabled">

    <TabBar>
        <ShellContent
            Title="Start"
            ContentTemplate="{DataTemplate local:MainPage}"
            Route="MainPage" />

        <ShellContent
            Title="Kursy"
            ContentTemplate="{DataTemplate local:AllCourses}"
            Route="AllCourses" />
    </TabBar>
    

</Shell>
